{
  "name": "maplibre-contour-formlines",
  "version": "0.1.0",
  "description": "Generate contour and form lines from raster elevation tiles in MapLibre GL JS",
  "unpkg": "dist/index.min.js",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "default": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "require": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "browser": "./dist/index.min.js"
  },
  "scripts": {
    "bench": "npm run build && node benchmark.js",
    "build": "node scripts/clean-dist.mjs && rollup -c && npm run generate-types && tsc --project tsconfig.dist.json",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "test-build-v3": "cd test-project-maplibre-3 && rm -rf node_modules && rm -rf package-lock.json && npm i && npm test",
    "test-build": "cd test-project && rm -rf node_modules && rm -rf package-lock.json && npm i && npm test",
    "generate-types": "tsc --emitDeclarationOnly --declaration --outDir dist && node scripts/clean-generated-types.mjs",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "test": "run-p typecheck lint jest checkformat",
    "lint": "eslint src",
    "format": "prettier src --write",
    "checkformat": "prettier src --check",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjmsy/maplibre-contour-formlines.git"
  },
  "type": "module",
  "author": "tjmsy",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/tjmsy/maplibre-contour-formlines",
  "files": [
    "build/",
    "dist/*",
    "src/"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@mapbox/vector-tile": "3.0.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/benchmark": "2.1.5",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/mapbox__vector-tile": "2.0.0",
    "@types/node": "26.6.6",
    "@types/pbf": "3.0.5",
    "@types/pngjs": "6.0.5",
    "benchmark": "2.1.4",
    "canvas": "3.2.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lodash": "4.18.1",
    "npm-run-all": "4.1.5",
    "pbf": "5.1.2",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "rollup": "4.68.2",
    "ts-jest": "29.4.15",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "whatwg-fetch": "3.6.20"
  }
}
